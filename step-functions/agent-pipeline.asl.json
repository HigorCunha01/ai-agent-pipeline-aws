{
  "Comment": "Fluxo do agente: validar -> gerar resposta -> notificar",
  "StartAt": "ValidarEBuscarContexto",
  "States": {
    "ValidarEBuscarContexto": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:validate-and-fetch-context",
      "Next": "GerarESalvarResposta"
    },
    "GerarESalvarResposta": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:generate-and-save-response",
      "Next": "NotificarResposta"
    },
    "NotificarResposta": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:notify-response",
      "End": true
    }
  }
}
