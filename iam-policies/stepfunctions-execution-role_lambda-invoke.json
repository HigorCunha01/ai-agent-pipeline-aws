{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": "lambda:InvokeFunction",
            "Resource": [
                "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:validate-and-fetch-context",
                "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:generate-and-save-response",
                "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:notify-response"
            ]
        }
    ]
}
